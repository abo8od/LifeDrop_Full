@host = https://localhost:7894
@adminToken = your_admin_jwt_token_here
@hospitalAdminToken = your_hospital_admin_jwt_token_here
@hospitalEmployeeToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..NAmaY9WQ78XlnMsvQlWILxHYGeBishHQVeV0aUKnFO8

@donorToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-KDfAsuzrqkWvNwgYtXuAbaX5Bu_l32D2RrqHhhSzjY
# === VARIABLES FOR DYNAMIC IDs ===
# Run step 2.1 first to get these IDs
@governorateId = 3f7c9c2e-8a4d-4b7e-b1c2-9e5a6f3d2c11
@districtId = a8b4f1d9-3c72-4e6a-9f15-2b7c8d0e4a63
@hospitalId = 00000000-0000-0000-0000-000000000000
@donationRequestId = 00000000-0000-0000-0000-000000000000
@acceptanceId = 00000000-0000-0000-0000-000000000000
@donorUserId = 00000000-0000-0000-0000-000000000000

### =========================================
### 1. AUTHENTICATION & BOOTSTRAP
### =========================================

# 1.1 Bootstrap System Admin (Run ONCE only - creates first admin account)
# After this, you can only login with credentials created here
POST {{host}}/api/auth/bootstrap
Content-Type: application/json

{
  "email": "admin@lifedrop.jo",
  "password": "Admin123!",
  "bootstrapSecret": "LifeDrop2026Bootstrap"
}

###

# 1.2 Login - Get JWT tokens
# Use credentials from step 1.1 or credentials created from hospital/donor registration
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "amjad@gmail.com",
  "password": "Amjad@123"
}

###

# 1.3 Refresh Token
# Use the refreshToken from login response
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "your_refresh_token_here"
}


### =========================================
### 2. REFERENCE DATA (Public - No Auth Required)
### =========================================

# 2.1 Get Blood Types (Returns enum values like "O_Positive", "A_Negative", etc.)
GET {{host}}/api/reference-data/blood-types

###

# 2.2 Get Governorates (Returns list of governorates with IDs)
# Copy a governorate ID for use in next steps
GET {{host}}/api/locations/governorates

###

# 2.3 Get Districts by Governorate
# Replace {{governorateId}} with actual ID from step 2.2
GET {{host}}/api/locations/governorates/{{governorateId}}/districts

###

# 2.4 Save Reference IDs (Copy from responses above)
# @governorateId = <ID_FROM_2.2>
# @districtId = <ID_FROM_2.3>


### =========================================
### 3. HOSPITAL MANAGEMENT (Admin Only)
### =========================================

# 3.1 Create a new Hospital
# Requires: SystemAdmin or HospitalAdmin token
POST {{host}}/api/hospitals
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Jordan University Hospital",
  "latitude": 31.9454,
  "longitude": 35.9284
}

###

# 3.2 Create Hospital Admin
# hospitalId from step 3.1 response
POST {{host}}/api/hospitals/admin
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "hospitalId": "{{hospitalId}}",
  "firstName": "Ahmed",
  "lastName": "Kasem",
  "email": "hospital@lifedrop.jo",
  "password": "Hospital123!",
  "phoneNumber": "0790000000"
}

###

# 3.3 Create Hospital Employee
POST {{host}}/api/hospitals/employee
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "hospitalId": "{{hospitalId}}",
  "firstName": "Sara",
  "lastName": "Nurse",
  "email": "nurse@lifedrop.jo",
  "password": "Nurse123!",
  "phoneNumber": "0790000001",
  "department": "Blood Bank",
  "position": "Senior Nurse"
}

###

# 3.4 Get Current Hospital Profile & Statistics
# Returns hospital info with analytics (fulfillment rate, no-show rate, etc.)
GET {{host}}/api/hospitals/me
Authorization: Bearer {{hospitalEmployeeToken}}


### =========================================
### 4. DONOR MANAGEMENT
### =========================================

# 4.1 Register a new Donor
# Returns userId - save it as @donorUserId
POST {{host}}/api/donors/register
Content-Type: application/json

{
  "email": "donor1@lifedrop.jo",
  "password": "Donor123!",
  "firstName": "Ali",
  "lastName": "Test",
  "dateOfBirth": "1990-05-15",
  "bloodType": "O_Positive"
}

###

# 4.2 Login as Donor
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "donor1@lifedrop.jo",
  "password": "Donor123!"
}

###

# 4.3 Get Donor Profile
# Returns profile with blood type, gamification points, eligibility status
GET {{host}}/api/donors/me
Authorization: Bearer {{donorToken}}

###

# 4.4 Update Donor Profile (Set Location & Blood Type)
# bloodType: O_Positive, O_Negative, A_Positive, A_Negative, B_Positive, B_Negative, AB_Positive, AB_Negative
# isAvailable: true/false - toggles donor visibility in feeds
# governorateId & districtId: from step 2.2 and 2.3
PUT {{host}}/api/donors/me
Authorization: Bearer {{donorToken}}
Content-Type: application/json

{
  "bloodType": "O_Positive",
  "isAvailable": true,
  "governorateId": "{{governorateId}}",
  "districtId": "{{districtId}}"
}

###

# 4.5 Get Leaderboard (Top donors by points)
GET {{host}}/api/donors/leaderboard?limit=10&governorateId={{governorateId}}

###

# 4.6 Verify Donor Medical Info (Hospital Employee Only)
# After donor's first successful donation, hospital verifies their blood type
POST {{host}}/api/donors/verify
Authorization: Bearer {{hospitalEmployeeToken}}
Content-Type: application/json

{
  "donorUserId": "{{donorUserId}}",
  "bloodType": 0,
  "notes": "Verified via clinical test"
}


### =========================================
### 5. DONATION REQUESTS (Hospital Employee Only)
### =========================================

# 5.1 Create a Donation Request
# bloodType: 0=O_Positive, 1=O_Negative, 2=A_Positive, 3=A_Negative, 4=B_Positive, ...
# urgency: 0=Normal, 1=Urgent, 2=Critical
# districtIds: array of district IDs from step 2.3
POST {{host}}/api/donation-requests
Authorization: Bearer {{hospitalEmployeeToken}}
Content-Type: application/json

{
  "bloodType": 0,
  "targetQuota": 3,
  "urgency": 1,
  "targetDistrictIds": [
    "{{districtId}}"
  ],
  "expiryDate": "2026-12-31T23:59:59Z"
}

###

# 5.2 Get Hospital's Donation Requests (Paginated)
GET {{host}}/api/donation-requests?pageNumber=1&pageSize=10
Authorization: Bearer {{hospitalEmployeeToken}}

###

# 5.3 Get Request Details (Includes accepted donors list)
GET {{host}}/api/donation-requests/{{donationRequestId}}
Authorization: Bearer {{hospitalEmployeeToken}}

###

# 5.4 Mark Acceptance as Fulfilled (Donor arrived and donated)
# acceptanceId from step 5.3 response (acceptances array)
POST {{host}}/api/donation-requests/acceptances/{{acceptanceId}}/fulfill
Authorization: Bearer {{hospitalEmployeeToken}}

###

# 5.5 Mark Acceptance as No-Show (Donor didn't arrive)
POST {{host}}/api/donation-requests/acceptances/{{acceptanceId}}/no-show
Authorization: Bearer {{hospitalEmployeeToken}}

###

# 5.6 Cancel Donation Request (Hospital cancels their own request)
POST {{host}}/api/donation-requests/{{donationRequestId}}/cancel
Authorization: Bearer {{hospitalEmployeeToken}}


### =========================================
### 6. DONOR - FEED & ACCEPTANCE
### =========================================

# 6.1 Get Smart Donor Feed
# Returns matched requests (filtered by donor's location + blood type compatibility)
# Includes: hospital name, coordinates for maps, urgency, quota info
GET {{host}}/api/donation-requests/feed?pageNumber=1&pageSize=10
Authorization: Bearer {{donorToken}}

###

# 6.2 Accept a Donation Request
# RequestId from step 6.1 response
POST {{host}}/api/donation-requests/{{donationRequestId}}/accept
Authorization: Bearer {{donorToken}}

###

# 6.3 Cancel Acceptance (Emergency Cancellation)
# This applies reliability penalty and notifies other donors
POST {{host}}/api/donation-requests/{{donationRequestId}}/cancel-acceptance
Authorization: Bearer {{donorToken}}


### =========================================
### TESTING WORKFLOW EXAMPLE
### =========================================
# 
# Full flow test (execute in order):
# 1. Run 1.1 to bootstrap (if first time)
# 2. Run 1.2 to login as admin
# 3. Run 2.1 to get blood types
# 4. Run 2.2 to get governorates
# 5. Run 2.3 to get districts
#    -> Copy IDs to variables
# 6. Run 3.1 to create hospital
# 7. Run 3.2 to create hospital admin (save token)
# 8. Run 3.3 to create employee (save token)
# 9. Run 4.1 to register donor (save token)
# 10. Run 4.2 to login as donor
# 11. Run 4.4 to update donor profile (set location)
# 12. Run 5.1 to create donation request
# 13. Run 6.1 to see feed (donor)
# 14. Run 6.2 to accept request
# 15. Run 5.4 to fulfill (hospital)
# 16. Run 4.3 to verify points added